{
  "name": "quality-watcher-process",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/quality-watcher-process/src",
  "implicitDependencies": ["quality-watcher"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["quality-watcher:build"],
      "options": {
        "command": "pnpm run build",
        "cwd": "{projectRoot}"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx apps/quality-watcher-process/src/main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": ["app", "quality-watcher"]
}
