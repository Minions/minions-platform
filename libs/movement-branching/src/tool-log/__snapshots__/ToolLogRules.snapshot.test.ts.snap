exports[`Rule snapshots: intention classification > classifies intention from tool log entries 1`] = `
"Scenario                                           │ Intention       
───────────────────────────────────────────────────┼─────────────────
no entries                                         │ not_classified  
read-only tools only                               │ not_classified  
plan tool only (no edits)                          │ plan            
plan tool + doc edit                               │ docs            
plan tool + code edit                              │ code            
plan tool + test edit                              │ test            
code edit + test edit                              │ code            
code edit + no test edit (test run, no test file changes) │ refactor        
code file edited                                   │ code            
multiple code files                                │ code            
test file only                                     │ test            
test + code                                        │ code            
docs file only                                     │ docs            
docs + test                                        │ docs            
docs + code                                        │ code            
config file only                                   │ chore           
config + test                                      │ chore           
config + docs                                      │ chore           
config + docs + test                               │ chore           
CLAUDE.md (classified as code — workflow file)     │ code            
plan dir .md                                       │ plan            "
`;

exports[`Rule snapshots: intention merge matrix > produces merged intention from agent × analyzer 1`] = `
"analyzer ↓  agent → │ feature         │ bug             │ refactor        │ test            │ docs            │ chore           │ plan           
─────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼────────────────
not_classified │ feature         │ bug             │ refactor        │ test            │ docs            │ chore           │ plan           
multiple     │ multiple        │ multiple        │ multiple        │ multiple        │ multiple        │ multiple        │ multiple       
plan         │ feature         │ bug             │ refactor        │ test            │ docs            │ chore           │ plan           
test         │ feature         │ bug             │ refactor        │ test            │ docs            │ chore           │ test           
docs         │ feature         │ bug             │ refactor        │ test            │ docs            │ chore           │ docs           
chore        │ feature         │ bug             │ refactor        │ test            │ docs            │ chore           │ chore          
code         │ feature         │ bug             │ refactor        │ multiple        │ multiple        │ multiple        │ multiple       "
`;

exports[`Rule snapshots: risk classification > classifies risk from tool log entries 1`] = `
"Scenario                                                 │ Risk            
─────────────────────────────────────────────────────────┼─────────────────
no entries                                               │ not_classified  
only reads/search                                        │ not_classified  
docs edit only                                           │ .               
test edit only                                           │ ^               
config edit only                                         │ @               
code edit, no test run                                   │ @               
code edit → test run                                     │ !               
code edit (<9 LOC) + test edit → test run                │ ^               
code edit → test run → code edit (code after test)       │ @               
code edit → test run → docs edit (docs after test, not code) │ !               
code edit → vitest run                                   │ !               
code edit → jest run                                     │ !               
code edit → unrelated bash (not a test command)          │ @               
multiple test runs, last one after all code edits        │ !               "
`;
