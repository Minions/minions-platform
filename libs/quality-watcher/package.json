{
  "name": "@minions/quality-watcher",
  "version": "0.1.0",
  "description": "The Platform-generic IQualityWatcher/QualityWatcherFactory interface for the quality monitoring system that watches tests, types, lint, and build status — concrete implementations (real vitest/tsc/oxlint spawning) are software-development-domain tooling and live outside this open-source package.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "ai",
    "minions",
    "quality",
    "watcher"
  ],
  "author": "Untangler",
  "license": "None",
  "dependencies": {
    "@minions/events": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.19.0",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": ["platform:node"]
  }
}
